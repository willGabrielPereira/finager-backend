# ─── Finager — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB connection string.
# For local development (docker-compose) the API service overrides this to
# point to the "mongo" container. Adjust for staging/production as needed.
MONGO_URI=mongodb://localhost:27017

# Name of the MongoDB database.
MONGO_DB=finager

# Port the HTTP API will listen on.
PORT=8080

# Auth — credentials for the single admin user
API_LOGIN=admin
API_PASSWORD=

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
