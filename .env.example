# ─── Finager — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string (DSN).
# For local development (docker-compose) the API service overrides this to
# point to the "db" container. Adjust for staging/production as needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finager?sslmode=disable

# Port the HTTP API will listen on.
PORT=8080

# Comma-separated list of origins allowed by CORS (default: *).
# Example: http://localhost:3000,https://app.finager.com
CORS_ALLOWED_ORIGINS=*

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=
# Access token expiry (short-lived — 15 minutes recommended in production).
JWT_EXPIRATION_HOURS=1
# Refresh token expiry (long-lived — 7 days default).
JWT_REFRESH_EXPIRATION_HOURS=168

# ─── Seed (run: make seed) ────────────────────────────────────────────────────
# Credentials for the two initial users created by the seed script.
# Both users share the family defined by SEED_FAMILY_NAME.
USER1_LOGIN=admin
USER1_PASSWORD=

USER2_LOGIN=financeiro
USER2_PASSWORD=

SEED_FAMILY_NAME=Família Principal
